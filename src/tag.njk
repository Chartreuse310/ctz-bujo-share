{% set entries = site.entriesByTag[t.name] %}
{# tag 页：与集子页同构（夜·十拍板），侧栏复用 _includes/index-rail.njk；
   res-head h2 = 「# 显示名」，hint = tag · 多对多 · 按日期倒序。 #}
<div class="wrap">
<div class="index-layout">
  <aside class="rail">{% include "index-rail.njk" %}</aside>

  <main class="res-main">
    <div class="res-head">
      <h2># {{ t.name }}</h2>
      {% set evCount = entries | selectattr("type", "equalto", "event") | list | length %}
      {% set thCount = entries | length - evCount %}
      <span class="cnt">{{ entries | length }} 条 · 事件 {{ evCount }} / 思考 {{ thCount }}</span>
      <span class="hint">tag · 多对多 · 按日期倒序</span>
    </div>

    {% if entries | length %}
    <div class="res-list">
      {% for e in entries %}
      <a class="resrow" href="{{ e.url }}">
        <span class="d">{{ e.date }}<br>{{ weekdayName(e.date) }}</span>
        <div class="t"><h4{% if e.type == "thought" %} class="thought-title"{% endif %}>{% if e.type == "thought" %}<span class="thought-mark">{{ e.title }}</span>{% else %}{{ e.title }}{% endif %}</h4>{% set firstP = e.body | firstPara %}{% if firstP %}<div class="sub">{{ firstP }}</div>{% endif %}</div>
        <div class="r"><span class="tag type">{% if e.type == "event" %}事件{% else %}思考{% endif %}</span><span class="tag">{{ e.collectionName }}</span></div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="list-empty">{{ t.name }}还没有条目。登记了的集子/tag 都会生成页面，只是列表为空。</div>
    {% endif %}
  </main>
</div>
</div>
