{% set theDate = dayDate %}
{% set theDaily = site.dailyByDate[theDate] %}
{% set theEntries = site.entriesByDate[theDate] or [] %}
{% set theMonth = theDate | substr(0, 7) %}
{% set grid = buildMonthGrid(theMonth, site.entries, site.today, site.dailies) %}
{% set monthFact = monthFacts(theMonth, site.entries, site.dailies) %}
<div class="wrap">
<div class="home">
  <main class="day">
    <div class="dateline">
      <b>{{ theDate | zhDate }}</b>
      <em>{{ weekdayName(theDate) }} · 第 {{ dayOfYear(theDate) }} 天</em>
      <span class="facts">{{ theEntries | length }} 条条目 · {% if theDaily %}1{% else %}0{% endif %} 条日总结 · {% set hl = theEntries | selectattr("highlight") | list | length %}{{ hl }} 条重点</span>
    </div>

    {% if theDaily %}
    <aside class="pull">
      <b class="lbl">今日小结</b>
      <h2>{{ theDaily.title }}</h2>
      {{ theDaily.body | renderContent("md") | safe }}
    </aside>
    {% endif %}

    {% if theEntries | length %}
    <div class="sect-h"><h3>条目</h3></div>
    {% for e in theEntries %}
    <article class="entry">
      <div class="top-row">
        <span class="idx">{{ loop.index }}</span>
        <h4><a href="{{ e.url }}">{{ e.title }}</a></h4>
      </div>
      <div class="tags">
        <span class="tag type">{% if e.type == "event" %}事件{% else %}思考{% endif %}</span>
        <span class="tag coll">{{ e.collectionName }}</span>
        {% for t in e.tags %}<span class="tag"># {{ t }}</span>{% endfor %}
        {% if e.highlight %}<span class="tag hl">重点</span>{% endif %}
      </div>
      {# 三行排版截断（§5.2，2026-10-15 拍板）：渲染整篇正文，CSS line-clamp:3 兜底；「全文 →」由 excerpt.js 在真被截断时插入 #}
      {% set rendered = e.body | renderContent("md") %}
      {% if rendered %}<div class="excerpt" data-href="{{ e.url }}">{{ rendered | safe }}</div>{% endif %}
    </article>
    {% endfor %}
    {% else %}
    <div class="empty">这里是空的。</div>
    {% endif %}
  </main>

  <aside class="side">
    <div class="blk">
      <div class="blk-h"><h3>小月历</h3><span class="lnk"><a href="{{ base }}/month/{{ theMonth }}/">月视图 →</a></span></div>
      <div class="mini">
        <div class="mini-head"><a class="m" href="{{ base }}/month/{{ theMonth }}/">{{ theMonth | replace("-", " · ") }}</a></div>
        <div class="mini-dow">{% for w in weekdaysOf() %}<span>{{ w }}</span>{% endfor %}</div>
        <div class="mini-grid">
          {% for c in grid.cells %}
            {% if c.blank %}<span class="void" aria-hidden="true"></span>
            {% else %}<a class="mini-cell {% if c.entryCount %}has{% endif %} {% if c.hasHighlight %}hl{% endif %} {% if c.date == theDate %}sel{% endif %} {% if c.isToday %}today{% endif %}" href="{{ base }}/day/{{ c.date }}/" title="{{ c.date }}{% if c.entryCount %} · {{ c.entryCount }} 条{% endif %}"><span>{{ c.day }}</span><i class="ul"></i></a>
            {% endif %}
          {% endfor %}
        </div>
        <div class="mini-foot"><b></b>今天</div>
      </div>
    </div>
    <div class="blk">
      <div class="blk-h"><h3>统计</h3><span class="lnk"><a href="{{ base }}/stats/">查看统计 →</a></span></div>
      <a class="stat-pair" href="{{ base }}/stats/" title="进入统计页">
        <span class="p"><span class="n">{{ site.entries | length }}</span><span class="l">条目</span><span class="s">本月 {{ monthFact.entries }}</span></span>
        <span class="p"><span class="n">{{ site.dailies | length }}</span><span class="l">日总结</span><span class="s">本月 {{ monthFact.dailies }}</span></span>
      </a>
    </div>
  </aside>
</div>
</div>
