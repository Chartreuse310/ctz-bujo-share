<article class="landing-thought">
  <p class="landing-meta">{{ e.date }} · {{ e.collectionName }}</p>
  <h3 class="thought-title"><a href="{{ e.url }}">{{ e.title }}</a></h3>
  <div class="landing-excerpt">{{ homeThoughtBody | safe }}</div>
  <a class="landing-read" href="{{ e.url }}">读这条思考 →</a>
</article>
