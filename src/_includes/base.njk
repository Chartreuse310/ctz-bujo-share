<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="{{ base }}/assets/favicon.svg" />
  <title>{% if title %}{{ title }} · {% endif %}ctz/bujo</title>
  <link rel="stylesheet" href="{{ base }}/assets/style.css" />
</head>
<body>
  <a class="brand" href="{{ base }}/" aria-label="ctz/bujo 首页">ctz<span>/</span>bujo</a>

  <main>
    {{ content | safe }}
  </main>

  <nav class="nav tabbar" aria-label="四屏导航">
    <a href="{{ base }}/month/{{ site.thisMonth }}/"{% if navActive == 'month' %} class="on" aria-current="page"{% endif %}>本月</a>
    <a href="{{ base }}/today/"{% if navActive == 'home' %} class="on" aria-current="page"{% endif %}>近日</a>
    <a href="{{ base }}/collection/all/"{% if navActive == 'index' %} class="on" aria-current="page"{% endif %}>集子 · 标签</a>
    <a href="{{ base }}/stats/"{% if navActive == 'stats' %} class="on" aria-current="page"{% endif %}>统计</a>
  </nav>

  <script src="{{ base }}/assets/nav.js" defer></script>
  <script src="{{ base }}/assets/excerpt.js" defer></script>
</body>
</html>
