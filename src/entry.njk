<div class="wrap entry-wrap">
<article class="entry-page postcard">
  <header class="postcard-head">
    <div class="postcard-date">{{ entry.date | zhDate }} · {{ weekdayName(entry.date) }}</div>
    <h1{% if entry.type == "thought" %} class="thought-title"{% endif %}>{% if entry.type == "thought" %}<span class="thought-mark">{{ entry.title }}</span>{% else %}{{ entry.title }}{% endif %}</h1>
  </header>
  <div class="entry-body">
    {{ entry.body | renderContent("md") | safe }}
  </div>
  <footer class="postcard-foot">
    <div class="postcard-tags">
      <span class="tag type">{% if entry.type == "event" %}事件{% else %}思考{% endif %}</span>
      <a class="tag coll" href="{{ entry.collectionUrl }}">{{ entry.collectionName }}</a>
      {% if entry.highlight %}<span class="tag hl">重点</span>{% endif %}
      {% for t in entry.tagsResolved %}<a class="tag" href="{{ t.url }}"># {{ t.name }}</a>{% endfor %}
    </div>
    <p class="backlink"><a href="{{ base }}/day/{{ entry.date }}/">← 回到 {{ entry.date }} 的日页</a></p>
  </footer>
</article>
</div>
