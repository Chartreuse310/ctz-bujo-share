---
layout: base.njk
title: 今日
navActive: home
permalink: /
---
{% set todayDaily = site.dailyByDate[site.today] %}
{% set todayEntries = site.entriesByDate[site.today] or [] %}
{% set grid = buildMonthGrid(site.thisMonth, site.entries, site.today) %}
<div class="home">
  <main class="day">
    <div class="dateline">
      <h1>{{ site.today | zhDate }}</h1>
      <em>{{ weekdayName(site.today) }} · 第 {{ dayOfYear(site.today) }} 天</em>
      <span class="facts">{{ todayEntries | length }} 条条目 · {% if todayDaily %}1{% else %}0{% endif %} 条日总结 · {% set hl = todayEntries | selectattr("highlight") | list | length %}{{ hl }} 条重点</span>
    </div>

    {% if todayDaily %}
    <aside class="pull">
      <b>今日小结</b>
      <p>{{ todayDaily.title }}</p>
      {{ todayDaily.body | renderContent("md") | safe }}
    </aside>
    {% endif %}

    {% if todayEntries | length %}
    <div class="sect-h">条目</div>
    {% for e in todayEntries %}
    <article class="entry">
      <div class="r1">
        <span class="idx">{{ loop.index }}</span>
        <h4><a href="{{ e.url }}">{{ e.title }}</a></h4>
      </div>
      <p class="meta">{% if e.type == "event" %}事件{% else %}思考{% endif %}{% if e.collectionName %} · {{ e.collectionName }}{% endif %}{% for t in e.tags %} · #{{ t }}{% endfor %}{% if e.highlight %} · <b class="hl">重点</b>{% endif %}</p>
      {# 三行排版截断（§5.2，2026-10-15 拍板）：渲染整篇正文，CSS line-clamp:3 兜底；「全文 →」由 excerpt.js 在真被截断时插入 #}
      {% set rendered = e.body | renderContent("md") %}
      {% if rendered %}<div class="excerpt" data-href="{{ e.url }}">{{ rendered | safe }}</div>{% endif %}
    </article>
    {% endfor %}
    {% else %}
    <div class="list-empty">今天还没有条目。</div>
    {% endif %}
  </main>

  <aside class="side">
    <div class="mini">
      <div class="mini-head"><span class="m">{{ site.thisMonth | replace("-", " · ") }}</span></div>
      <div class="mini-dow">{% for w in weekdaysOf() %}<span>{{ w }}</span>{% endfor %}</div>
      <div class="mini-grid">
        {% for c in grid.cells %}
          {% if c.blank %}<button class="void" disabled></button>
          {% else %}<a class="mini-cell {% if c.hasHighlight %}hl{% endif %} {% if c.isToday %}today{% endif %}" href="/day/{{ c.date }}/" title="{{ c.date }}{% if c.entryCount %} · {{ c.entryCount }} 条{% endif %}"><span>{{ c.day }}</span><i class="ul"></i></a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="stat-entry">
      <div class="stat-pair">
        <div class="p"><span class="n">{{ site.entries | length }}</span><span>条目</span></div>
        <div class="p"><span class="n">{{ site.dailies | length }}</span><span>日总结</span></div>
      </div>
      <a class="stat-link" href="/stats/">进入统计 →</a>
    </div>
  </aside>
</div>
